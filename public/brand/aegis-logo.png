<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="100%" height="100%">
  <!-- Aegis Official Logo Vector -->
  <defs>
    <radialGradient id="sparkle" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
      <stop offset="25%" stop-color="#ffffff" stop-opacity="0.8" />
      <stop offset="60%" stop-color="#60a5fa" stop-opacity="0.3" />
      <stop offset="100%" stop-color="#1e3a8a" stop-opacity="0" />
    </radialGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="3" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>

  <!-- Background is transparent -->
  <g transform="translate(0, 50)">
    <!-- Main "Aegis" Typography Group -->
    <g font-family="'Inter', 'Montserrat', 'Helvetica Neue', 'Arial', sans-serif" font-weight="900">
      <!-- Blue "A" -->
      <text x="60" y="240" font-size="180" fill="#203a9b" letter-spacing="-8">A</text>
      
      <!-- White "egis" -->
      <text x="180" y="240" font-size="150" fill="#ffffff" letter-spacing="-4">egis</text>
    </g>

    <!-- Glowing Dot on the "i" (over the i stem) -->
    <g transform="translate(365, 142)">
      <!-- Outer radiant flare -->
      <circle cx="0" cy="0" r="28" fill="url(#sparkle)" />
      <!-- Star rays -->
      <line x1="-24" y1="0" x2="24" y2="0" stroke="#ffffff" stroke-width="1.5" opacity="0.9" />
      <line x1="0" y1="-24" x2="0" y2="24" stroke="#ffffff" stroke-width="1.5" opacity="0.9" />
      <line x1="-16" y1="-16" x2="16" y2="16" stroke="#ffffff" stroke-width="1" opacity="0.6" />
      <line x1="-16" y1="16" x2="16" y2="-16" stroke="#ffffff" stroke-width="1" opacity="0.6" />
      <!-- Bright white center orb -->
      <circle cx="0" cy="0" r="11" fill="#ffffff" filter="url(#glow)" />
    </g>

    <!-- Subtitle "ACADEMY" -->
    <text x="445" y="258" font-family="'Inter', 'Montserrat', sans-serif" font-size="24" font-weight="800" fill="#ffffff" letter-spacing="4" text-anchor="end">
      ACADEMY
    </text>

    <!-- Tagline: "Where guidance meet growth" -->
    <text x="250" y="308" font-family="'Inter', 'Montserrat', sans-serif" font-size="17" font-weight="500" fill="#94a3b8" letter-spacing="4.5" text-anchor="middle">
      Where guidance meet growth
    </text>
  </g>
</svg>
